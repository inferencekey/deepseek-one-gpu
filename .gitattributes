# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text

# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf
*.bat text eol=crlf

# copies of real packs' native_experts.txt, parsed byte for byte by tests/core/expert_layout_test.cpp
tests/data/native_experts/** -text

# the fork patch is hashed byte for byte (fork tarball MANIFEST)
third_party/llama-dsv41/*.patch -text

# E06: the tokenizer's parity corpus and llama.cpp's codepoint table are read byte for byte
tools/dsv41/engine/tokenizer_corpus.txt -text
tools/llama_unicode_flags.txt -text
